# Configurazione della devbox Tradenza (opzionale).
# Tutto ha un default: `make up` funziona SENZA questo file.
# Copia in docker/.env per personalizzare:  cp docker/.env.example docker/.env

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=tradenza
POSTGRES_PORT=5432

# ── App ─────────────────────────────────────────────────────────────────────
APP_PORT=3000

# ── Auth: bypass Clerk (mono-utente, no login) ──────────────────────────────
AUTH_DISABLED=1
DEV_USER_ID=user_dev_local
DEV_USER_EMAIL=dev@tradenza.local
DEV_USER_FIRST_NAME=Dev
DEV_USER_LAST_NAME=User
DEV_USERNAME=dev

ADMIN_EMAILS=

# ── Clerk (solo se AUTH_DISABLED=0) ─────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_cGxhY2Vob2xkZXIudHJhZGVuemEuZGV2JA==
CLERK_SECRET_KEY=sk_test_dev_placeholder
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── Domini (vuoti in dev) ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_MARKETING_URL=

# ── Optional (disabilitati in devbox) ───────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_SENTRY_DSN=

SKIP_MIGRATIONS=0
